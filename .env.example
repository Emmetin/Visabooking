# Скопируйте в .env и заполните. Файл .env никуда не отправляется и не коммитится.

# Telegram: токен от @BotFather и ваш chat_id (узнать: python -m vfs_monitor.telegram_setup)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Страница VFS для Франции в России
VFS_BASE_URL=https://visa.vfsglobal.com/rus/ru/fra

# Регулярные выражения для выпадающих списков (по порядку на странице записи).
# Если вариант не найдётся, бот пришлёт в Telegram список реальных вариантов — скопируйте нужный.
CENTRE=Москв|Moscow
CATEGORY=Кратк|Short|Шенген|Schengen
SUBCATEGORY=Туриз|Touris

# Пауза между проверками, минуты (случайно в диапазоне; меньше 2 нельзя — VFS забанит)
INTERVAL_MIN_MINUTES=4
INTERVAL_MAX_MINUTES=7

# chrome = ваш установленный Google Chrome (рекомендуется); пусто = встроенный Chromium
BROWSER_CHANNEL=chrome
